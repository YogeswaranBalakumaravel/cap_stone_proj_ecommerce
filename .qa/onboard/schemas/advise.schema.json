     "agree": {"type": "boolean"},
     "note": {"type": "string"}
    }
   }
  },
  "adjustments": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["title", "file", "snippet", "why", "resolves", "evidence"],
    "properties": {
     "title": {"type": "string"},
     "file": {"type": "string"},
     "snippet": {"type": "string"},
     "why": {"type": "string"},
     "resolves": {"type": "array", "items": {"type": "string"}},
     "evidence": {"$ref": "#/definitions/evidence"}
    }
   }
  },
  "extra_skips": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["title", "gate", "what_happens", "fix", "evidence"],
    "properties": {
